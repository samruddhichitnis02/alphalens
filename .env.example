# AlphaLens Environment Configuration
# SEC EDGAR requires a custom User-Agent in the format: "Sample Company Name AdminContact@<sample company domain>.com"
SEC_USER_AGENT="AlphaLensResearch lab@alphalens.ai"
SEC_MAX_REQUESTS_PER_SECOND=8.0

# Database Configuration (Postgres for production / SQLite for zero-setup local development)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/alphalens"
# Optional fallback if Postgres is not running:
# DATABASE_URL="sqlite+aiosqlite:///./data/alphalens.db"

# OpenSearch Configuration
OPENSEARCH_HOST="http://localhost:9200"
OPENSEARCH_INDEX="alphalens-filing-chunks"
OPENSEARCH_USERNAME=""
OPENSEARCH_PASSWORD=""

# Embedding Configuration (Local sentence-transformers, free & local)
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# LLM Configuration
# Providers: "claude" | "gemini" | "ollama" | "mock"
LLM_PROVIDER="claude"
ANTHROPIC_API_KEY="your-anthropic-api-key"
CLAUDE_EXTRACTION_MODEL="claude-3-5-haiku-latest"
CLAUDE_RESEARCH_MODEL="claude-3-5-sonnet-latest"

# Optional alternative free LLM settings:
# LLM_PROVIDER="gemini"
# GEMINI_API_KEY="your-gemini-api-key"
# OLLAMA_BASE_URL="http://localhost:11434"

# Chunking Configuration
DEFAULT_CHUNK_SIZE=400
DEFAULT_CHUNK_OVERLAP=50

# Concurrency & Ingestion
EXTRACTION_SEMAPHORE_LIMIT=5
MAX_RETRIES=3
LOG_LEVEL="INFO"

